{
  "permissions": {
    "allow": [
      "Edit(progress/**)",
      "Edit(lessons/**)",
      "Edit(journal/**)",
      "Edit(reviews/**)",
      "Edit(README.md)",
      "Write(progress/**)",
      "Write(lessons/**)",
      "Write(journal/**)",
      "Write(reviews/**)",
      "Bash(date:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }
        ]
      }
    ]
  }
}
